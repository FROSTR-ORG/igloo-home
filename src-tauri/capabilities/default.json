{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for Igloo Home",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:path:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:menu:default",
    "dialog:allow-confirm",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
